{
  "name": "stellar-web-sdk",
  "version": "0.1.0",
  "description": "Self-contained Stellar swap SDK: provider adapters (StellarBroker, Soroswap, Aquarius, Stellar DEX, NEAR, Axelar ITS), quote fetching and normalization, route construction, provider fan-out and best-output route selection, with client-native execution.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:react": "tsc -p tsconfig.react.json",
    "build:all": "npm run build && npm run build:react",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:react": "tsc -p tsconfig.react.json --noEmit",
    "test": "npm run build && node test/run.mjs",
    "clean": "rm -rf dist",
    "bench": "npm run build && node bench/routing.mjs"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^13.3.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.0",
    "buffer": "^6.0.3",
    "esbuild": "^0.28.1",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "stellar",
    "swap",
    "dex",
    "defi",
    "stellarbroker",
    "soroswap",
    "aquarius",
    "soroban",
    "axelar",
    "near-intents",
    "uswap"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/horizontalsystems/stellar-web-sdk.git"
  },
  "homepage": "https://github.com/horizontalsystems/stellar-web-sdk#readme",
  "bugs": {
    "url": "https://github.com/horizontalsystems/stellar-web-sdk/issues"
  }
}
