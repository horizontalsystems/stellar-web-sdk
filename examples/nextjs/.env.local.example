# Both are OPTIONAL — the SDK quotes and executes without any backend.
#
# Soroswap requires its own key on every swap endpoint. Without one that single provider
# declines with a clear error and the other three Stellar providers still serve the pair.
NEXT_PUBLIC_SOROSWAP_API_KEY=

# Needed only to COMMIT a StellarBroker route (its WebSocket session). Quoting works without it.
NEXT_PUBLIC_STELLARBROKER_PARTNER_KEY=
